# ===== Servidor =====
NODE_ENV=development
PORT=4000
# Cantidad de proxies delante de Node (Nginx/Passenger en DonWeb = 1)
TRUST_PROXY=1

# ===== Base de datos SQLite3 =====
DB_PATH=data/menu.sqlite
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

# ===== Seguridad =====
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PUBLIC_RATE_LIMIT_PER_MIN=120
# En producción con HTTPS: COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# ===== Frontend =====
# Orígenes permitidos (coma separada). Ej: https://carta.midominio.com.ar
CORS_ORIGINS=http://localhost:5173
# URL pública del frontend (se usa para generar los QR de las mesas)
PUBLIC_APP_URL=http://localhost:5173
# Opcional: ruta al build del frontend para servirlo desde este mismo proceso
SERVE_FRONTEND_DIR=

# ===== Facturación =====
# "interno": comprobantes no fiscales (sin CAE). Ver docs/DEPLOY.md para factura electrónica ARCA.
FISCAL_PROVIDER=interno

# ===== Usuario administrador inicial (solo para "npm run db:seed") =====
ADMIN_USERNAME=
ADMIN_NAME=
ADMIN_PASSWORD=
